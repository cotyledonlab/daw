{
  "addTrack": {"roles":["producer","musician"],"fields":{"id":"string","kind":"sine|synth|drumkit"}},
  "deleteTrack": {"roles":["producer"],"fields":{"track_id":"string"}},
  "addClip": {"roles":["producer","musician"],"fields":{"track_id":"string","clip":"{id,start_frame,length_frames,notes:[]}"}},
  "moveClip": {"roles":["producer","musician"],"fields":{"track_id":"string","clip_id":"string","start_frame":"integer"}},
  "resizeClip": {"roles":["producer","musician"],"fields":{"track_id":"string","clip_id":"string","length_frames":"integer"}},
  "duplicateClip": {"roles":["producer","musician"],"fields":{"track_id":"string","clip_id":"string","id":"string","start_frame":"integer"}},
  "deleteClip": {"roles":["producer","musician"],"fields":{"track_id":"string","clip_id":"string"}},
  "addNote": {"roles":["producer","musician"],"fields":{"track_id":"string","clip_id":"string","note":"{id,start_frame,duration_frames,frequency_hz,velocity:0..1}"}},
  "editNote": {"roles":["producer","musician"],"fields":{"track_id":"string","clip_id":"string","note_id":"string","patch":"subset of start_frame,duration_frames,frequency_hz,velocity"}},
  "deleteNote": {"roles":["producer","musician"],"fields":{"track_id":"string","clip_id":"string","note_id":"string"}},
  "transpose": {"roles":["producer","musician"],"fields":{"track_id":"string","clip_id":"string","semitones":"number"}},
  "setNotes": {"roles":["producer","musician"],"fields":{"track_id":"string","clip_id":"existing note clip","notes":"0..128 complete notes: {id,start_frame,duration_frames,frequency_hz,velocity:0..1}; replaces notes only, preserves clip placement/length"}},
  "copyNotes": {"roles":["producer","musician"],"fields":{"track_id":"string","clip_id":"existing source clip","target_clip_ids":"1..64 existing note clips with originally identical notes (ignoring IDs); preserves clip positions/lengths"}},
  "mixer": {"roles":["producer","engineer"],"fields":{"track_id":"string","patch":"subset of gain,pan,mute,solo"}},
  "gainDb": {"roles":["producer","engineer"],"fields":{"track_id":"string","db":"number (relative to current mixer gain)"}},
  "device": {"roles":["producer","engineer","musician"],"fields":{"track_id":"string","patch":"built-in device numeric controls; synth waveform; Pd gain/controls. No kind/program changes"}},
  "audioClip": {"roles":["producer","engineer"],"fields":{"track_id":"string","clip_id":"string","patch":"subset of source_offset_frames,length_frames,gain,fade_in_frames,fade_out_frames"}},
  "addEffect": {"roles":["producer","engineer"],"fields":{"track_id":"string","id":"string","effect":"{kind:gain,gain,bypass} or {kind:lowpass,cutoff_hz,bypass} or {kind:delay,time_ms,feedback,mix,bypass}"}},
  "effect": {"roles":["producer","engineer"],"fields":{"track_id":"string","effect_id":"string","patch":"built-in effect controls"}},
  "removeEffect": {"roles":["producer","engineer"],"fields":{"track_id":"string","effect_id":"string"}},
  "addGainPoint": {"roles":["producer","engineer"],"fields":{"track_id":"string","effect_id":"string","point":"{frame,value}"}},
  "editGainPoint": {"roles":["producer","engineer"],"fields":{"track_id":"string","effect_id":"string","frame":"integer","point":"{frame,value}"}},
  "deleteGainPoint": {"roles":["producer","engineer"],"fields":{"track_id":"string","effect_id":"string","frame":"integer"}},
  "tempo": {"roles":["producer"],"fields":{"tempo_milli_bpm":"integer; changes grid only"}},
  "command": {"roles":["producer"],"fields":{"name":"play|pause|stop|undo|redo|save|export|importWav|loadProject|newArrangement|demo|preview|connectMidi|recordNotes|applyTake|discardTake|seek|loop|monitor","args":"object; seek:{frame}; loop:{region:null or {start_frame,end_frame}}; monitor:{volume:0..1}; export:{seconds}; others:{}"}}
}
